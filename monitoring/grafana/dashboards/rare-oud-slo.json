{
  "title": "Rare Oud SLO Overview",
  "schemaVersion": 39,
  "version": 1,
  "panels": [
    {"type":"stat","title":"HTTP Requests","gridPos":{"x":0,"y":0,"w":6,"h":4},"targets":[{"expr":"sum(rate(rare_oud_http_requests_total[5m]))"}]},
    {"type":"stat","title":"HTTP 5xx","gridPos":{"x":6,"y":0,"w":6,"h":4},"targets":[{"expr":"sum(rate(rare_oud_http_errors_total[5m]))"}]},
    {"type":"timeseries","title":"p95 API Latency","gridPos":{"x":0,"y":4,"w":12,"h":8},"targets":[{"expr":"histogram_quantile(0.95, sum(rate(rare_oud_http_request_duration_seconds_bucket[5m])) by (le))"}]},
    {"type":"timeseries","title":"Queue Failures / Dead Letters","gridPos":{"x":12,"y":0,"w":12,"h":8},"targets":[{"expr":"sum(rate(rare_oud_queue_jobs_failed_total[5m]))"},{"expr":"sum(rate(rare_oud_queue_dead_letter_total[5m]))"}]}
  ]
}
