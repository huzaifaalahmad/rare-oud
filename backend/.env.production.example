NODE_ENV=production
PORT=5000
FRONTEND_URL=https://your-domain.vercel.app
CORS_ORIGINS=https://your-domain.vercel.app
# Preferred for TiDB Cloud or managed MySQL. Set DB_NAME=rare_oud to override the URL path if needed.
DATABASE_URL=mysql://user:password@host:4000/rare_oud?ssl={"rejectUnauthorized":true}
DB_HOST=your-mysql-host
DB_PORT=3306
DB_USER=your-db-user
DB_PASSWORD=use_a_strong_database_password
DB_NAME=rare_oud
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=true
JWT_SECRET=replace_with_64_plus_random_chars_for_access_tokens
JWT_REFRESH_SECRET=replace_with_different_64_plus_random_chars_for_refresh_tokens
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_DAYS=30
COOKIE_SECURE=true
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMeToStrongUniquePassword!
ADMIN_NAME=Rare Oud Admin
UPLOAD_MAX_MB=3
CDN_BASE_URL=https://your-cdn.example.com
SENTRY_DSN=

# Email provider for forgot password
SMTP_SERVICE=gmail
SMTP_USER=your-email@example.com
SMTP_PASS=your-app-password


# Cloudflare R2 / AWS S3 object storage for production uploads
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT=


# JWT_SECRET: generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Must be 64+ chars and DIFFERENT from JWT_REFRESH_SECRET.

# v11 Enterprise hardening
UPLOAD_MAX_FILE_SIZE_BYTES=2097152
UPLOAD_MAX_FILES=8
ENABLE_UPLOAD_AV_SCAN=true
UPLOAD_AV_COMMAND=clamscan
UPLOAD_AV_ARGS=--no-summary
MEMORY_CACHE_TTL_MS=60000
PRODUCT_LIST_CACHE_TTL_MS=30000
PRODUCT_DETAIL_CACHE_TTL_MS=30000
METRICS_TOKEN=replace-with-long-random-token
SENTRY_DSN=

# Enterprise hardening
ENABLE_UPLOAD_AV_SCAN=true
UPLOAD_AV_COMMAND=clamscan
UPLOAD_AV_ARGS=--no-summary
UPLOAD_AV_TIMEOUT_MS=15000
UPLOAD_MAX_PIXELS=24000000
UPLOAD_WEBP_QUALITY=82
EMAIL_QUEUE_ENABLED=false
NOTIFICATION_QUEUE_ENABLED=false
QUEUE_ATTEMPTS=5
QUEUE_BACKOFF_MS=2000
QUEUE_REPLAY_ATTEMPTS=3
WORKER_HEARTBEAT_MS=30000
DB_SLOW_QUERY_MS=200
DB_POOL_LIMIT=20
OTEL_ENABLED=true
OTEL_SERVICE_NAME=rare-oud-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318/v1/traces
