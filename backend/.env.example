NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional: use DATABASE_URL for TiDB/managed MySQL instead of DB_HOST/DB_USER fields.
DATABASE_URL=
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=rare_oud
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
JWT_SECRET=change_me_to_64_chars_minimum_random_secret_for_access_tokens
JWT_REFRESH_SECRET=change_me_to_different_64_chars_minimum_random_secret_for_refresh_tokens
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_DAYS=30
COOKIE_SECURE=false
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMeToStrong!
ADMIN_NAME=Rare Oud Admin
UPLOAD_MAX_MB=3
CDN_BASE_URL=
SENTRY_DSN=

# Email provider for forgot password
SMTP_SERVICE=gmail
SMTP_USER=your-email@example.com
SMTP_PASS=your-app-password


# JWT_SECRET: generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Must be 64+ chars and DIFFERENT from JWT_REFRESH_SECRET.

# v11 Enterprise hardening
UPLOAD_MAX_FILE_SIZE_BYTES=12582912
UPLOAD_MAX_FILES=4
ENABLE_UPLOAD_AV_SCAN=false
UPLOAD_AV_COMMAND=clamscan
UPLOAD_AV_ARGS=--no-summary
MEMORY_CACHE_TTL_MS=60000
PRODUCT_LIST_CACHE_TTL_MS=30000
PRODUCT_DETAIL_CACHE_TTL_MS=30000
METRICS_TOKEN=
SENTRY_DSN=

# Enterprise queues / Redis
REDIS_URL=redis://localhost:6379
DISABLE_QUEUES=false
EMAIL_QUEUE_ENABLED=false
NOTIFICATION_QUEUE_ENABLED=false
QUEUE_ATTEMPTS=5
QUEUE_BACKOFF_MS=2000
QUEUE_REMOVE_COMPLETE=1000
QUEUE_REMOVE_FAIL=5000
EMAIL_QUEUE_MAX_PER_MINUTE=60
QUEUE_EMAIL_CONCURRENCY=5
QUEUE_NOTIFICATION_CONCURRENCY=10
QUEUE_AUDIT_CONCURRENCY=10
QUEUE_MEDIA_CONCURRENCY=3
CACHE_TTL_SECONDS=60
PRODUCT_LIST_CACHE_TTL_SECONDS=30
PRODUCT_DETAIL_CACHE_TTL_SECONDS=30

# S3 or Cloudflare R2 object storage
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
CDN_BASE_URL=

# Security and observability
METRICS_TOKEN=
SENTRY_DSN=
CSP_SCRIPT_SRC=
CSP_STYLE_SRC=
CSP_IMG_SRC=
CSP_CONNECT_SRC=
ENABLE_UPLOAD_AV_SCAN=false
UPLOAD_AV_COMMAND=clamscan
UPLOAD_AV_ARGS=--no-summary

# Enterprise hardening
ENABLE_UPLOAD_AV_SCAN=false
UPLOAD_AV_COMMAND=clamscan
UPLOAD_AV_ARGS=--no-summary
UPLOAD_AV_TIMEOUT_MS=15000
UPLOAD_MAX_PIXELS=24000000
UPLOAD_WEBP_QUALITY=82
QUEUE_ATTEMPTS=5
QUEUE_BACKOFF_MS=2000
QUEUE_REPLAY_ATTEMPTS=3
WORKER_HEARTBEAT_MS=30000
DB_SLOW_QUERY_MS=250
DB_POOL_LIMIT=10
OTEL_ENABLED=false
OTEL_SERVICE_NAME=rare-oud-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318/v1/traces
